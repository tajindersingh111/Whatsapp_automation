# Postgres (local private cluster on 5436, see README)
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5436/wa_agent

# Dashboard / admin API login. Use a long random value.
ADMIN_TOKEN=
# Encrypts client secrets (WhatsApp tokens, store keys). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never change it after clients are connected (their saved secrets become unreadable).
ENCRYPTION_KEY=

# Public HTTPS URL of this server (shown to stores as their webhook URL)
PUBLIC_BASE_URL=http://localhost:8000

# Meta app (one app serves all client numbers)
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# Claude
ANTHROPIC_API_KEY=
DEFAULT_MODEL=claude-opus-5-5
DEFAULT_EFFORT=low

# Set false when running `python -m app.worker` as a separate process
RUN_WORKER_IN_PROCESS=true
